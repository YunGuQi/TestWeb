generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Question {
  id      Int      @id @default(autoincrement())
  testId  String   @default("emotional-friction")
  order   Int
  text    String
  options Option[]
}

model Option {
  id         Int      @id @default(autoincrement())
  text       String
  scores     String   @db.Text // 存储分数字典的 JSON 字符串，例如 {"sen":2, "rum":0}
  question   Question @relation(fields: [questionId], references: [id])
  questionId Int
}

model ResultConfig {
  id        Int      @id @default(autoincrement())
  testId    String   @default("emotional-friction")
  title     String
  desc      String   @db.Text
  quote     String   @db.Text
  imageUrl  String
  condition String   // 存储触发条件，如结果的 ID 或 tag
}

model GlobalConfig {
  id             Int      @id @default(autoincrement())
  testId         String   @default("emotional-friction")
  baseCount      Int      @default(0)
  danmakuSpeed   Int      @default(50)   // 速度百分比
  danmakuOpacity Int      @default(70)   // 透明度百分比
  danmakuContent String   @db.LongText // 包含各结果类型弹幕的 JSON 字符串
}

model TestRecord {
  id        String   @id @default(cuid())
  testId    String   @default("emotional-friction")
  deviceId  String?
  answers   String   @db.Text // 用户所有答题记录的 JSON 字符串
  resultId  Int?     // 最终测出的 ResultConfig 的 ID
  createdAt DateTime @default(now())
}

model ActivationCode {
  id         Int      @id @default(autoincrement())
  testId     String   @default("emotional-friction")
  code       String
  maxUses    Int      @default(3)
  isDisabled Boolean  @default(false)
  devices        String?  @db.Text // JSON string of device IDs
  boundResultKey String?  // To prevent VIP loophole (one code unlocking all results)
  createdAt      DateTime @default(now())

  @@unique([code, testId])
}
