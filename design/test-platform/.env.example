# 运行环境
NODE_ENV=production

# MySQL 数据库配置（真密码请在服务器由 openssl rand -hex 24 生成）
MYSQL_ROOT_PASSWORD=GENERATE_STRONG_ROOT_PASSWORD_HERE
MYSQL_DATABASE=test_platform
MYSQL_USER=test_platform_user
MYSQL_PASSWORD=GENERATE_STRONG_USER_PASSWORD_HERE

# Session 鉴权密钥（32 位以上随机字符）
JWT_SECRET=GENERATE_RANDOM_JWT_SECRET_MIN_32_CHARS

# Cloudflare Turnstile 密钥对（在 Cloudflare 为 test.linxj.com 独立新建）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA_YOUR_SITE_KEY_FOR_TEST_LINXJ_COM
TURNSTILE_SECRET_KEY=0x4AAAAAA_YOUR_SECRET_KEY_FOR_TEST_LINXJ_COM

# 前端防篡改 API 签名盐值（随机字符）
NEXT_PUBLIC_API_SALT=GENERATE_RANDOM_API_SALT_HERE

# 管理后台口令（由管理员自定强口令）
ADMIN_LOGIN_PASSWORD=GENERATE_ADMIN_LOGIN_PASSWORD_HERE
ADMIN_PREVIEW_SECRET=GENERATE_ADMIN_PREVIEW_SECRET_HERE
NEXT_PUBLIC_ADMIN_PRIVACY_PASSWORD=GENERATE_ADMIN_PRIVACY_PASSWORD_HERE
