# 运行环境
NODE_ENV=production

# 数据库与缓存（服务名与 docker-compose.yml 严格对应）
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=test_platform
MYSQL_USER=test_user
MYSQL_PASSWORD=your_mysql_password
DATABASE_URL="mysql://test_user:your_mysql_password@db:3306/test_platform"
REDIS_URL="redis://redis:6379"

# Session 与鉴权
JWT_SECRET=your_jwt_secret_min_32_chars

# Cloudflare Turnstile 密钥对（针对 test.linxj.com 独立生成）
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_for_test_linxj_com
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_for_test_linxj_com

# 防篡改签名盐值
NEXT_PUBLIC_API_SALT=your_api_salt_random_string

# 管理后台口令
ADMIN_LOGIN_PASSWORD=your_admin_login_password
ADMIN_PREVIEW_SECRET=your_admin_preview_secret
NEXT_PUBLIC_ADMIN_PRIVACY_PASSWORD=your_admin_privacy_password
